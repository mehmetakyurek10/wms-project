# Docker Compose bu dosyanin .env kopyasini okur.
# Kurulum: cp .env.example .env ve degerleri doldurun.

DB_NAME=wms
DB_ROOT_PASSWORD=

# En az 32 karakter. Uretmek icin: openssl rand -base64 48
JWT_SECRET=

# Uygulamanin yayinlanacagi port ve adres
APP_PORT=8080
APP_ORIGIN=http://localhost:8080

# APP_ORIGIN https:// degilse ve localhost da degilse bunu false yapin,
# aksi halde API acilista durur ve sebebini yazar.
COOKIE_SECURE=

# Saat dilimi. Konteynerler ve MySQL bu değere göre çalışır; ikisinin
# ayrışması gece yapılan işlemlerin bir önceki güne yazılmasına yol açar.
TZ=Europe/Istanbul
DB_TIMEZONE=+03:00