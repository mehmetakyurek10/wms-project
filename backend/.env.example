NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wms
DB_PORT=3306

# Bağlantı havuzu boyutu (varsayılan 20)
DB_POOL_SIZE=20

# En az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWT_SECRET=

# Virgülle ayrılmış izinli adresler
CORS_ORIGIN=http://localhost:5173

# Cerezin "secure" bayragi. Bos birakilirsa NODE_ENV=production ise acik olur.
# HTTPS olmayan bir ic ag adresinden yayin yapiyorsaniz false verin.
COOKIE_SECURE=

# Günlük seviyesi: silent, error, warn, info, debug
# Boş bırakılırsa geliştirmede debug, üretimde info, testte silent
LOG_LEVEL=debug

# MySQL bağlantısının saat dilimi. Boş bırakılırsa Node sürecinin yerel
# saati kullanılır; yerel geliştirmede bu doğru davranıştır.
DB_TIMEZONE=