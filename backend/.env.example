NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wms
DB_PORT=3306

# Bağlantı havuzu boyutu (varsayılan 20)
DB_POOL_SIZE=20

# En az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWT_SECRET=

# Virgülle ayrılmış izinli adresler
CORS_ORIGIN=http://localhost:5173
# Günlük seviyesi: silent, error, warn, info, debug
# Boş bırakılırsa geliştirmede debug, üretimde info, testte silent
LOG_LEVEL=debug